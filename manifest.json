{
  "manifest_version": 3,
  "name": "PF Expander",
  "version": "1.5.0",
  "description": "Expands configurable triggers in place into plain text, Unicode characters, or date/time stamps.",
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["format.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
